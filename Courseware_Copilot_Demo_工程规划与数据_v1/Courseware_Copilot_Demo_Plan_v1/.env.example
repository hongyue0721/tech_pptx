# 示例配置，不含凭据。须由M0校准，不能当已通过部署配置。
APP_ENV=local
APP_MODE=live
APP_DATA_DIR=./data
APP_BIND_HOST=127.0.0.1
APP_BIND_PORT=8000
APP_LLM_BASE_URL=https://api.example.invalid/v1
APP_LLM_API_KEY=
APP_LLM_MODEL=
APP_LLM_PROTOCOL=chat_completions
APP_LLM_CONNECT_TIMEOUT_SECONDS=10
APP_LLM_READ_TIMEOUT_SECONDS=120
APP_LLM_MAX_ATTEMPTS=2
APP_JOB_MAX_SECONDS=600
APP_JOB_MAX_LLM_CALLS=24
APP_LLM_MAX_CONCURRENCY=2
APP_DAILY_BUDGET_USD=
APP_EXPORTER=UNSELECTED
APP_PREVIEW_MODE=outline
APP_MAX_FILE_MIB=20
APP_MAX_PROJECT_FILES=5
APP_MAX_PROJECT_PAGES=200
APP_MAX_PROJECT_TEXT_CHARS=500000
APP_WEB_RETRIEVAL_ENABLED=false
APP_LOG_RAW_MODEL_CONTENT=false
# DEV CodeArts凭据在用户home配置，不复制进本.env，不使用VITE_密钥。
